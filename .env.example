# ============================================================
# PizzaHub Server — environment variables
# Copy to `.env` and fill in real values.
# `.env` is git-ignored and must NEVER be pushed to GitHub.
# ============================================================

# --- Runtime ---
NODE_ENV=development
PORT=5000
# Comma separated list of allowed client origins
CLIENT_ORIGIN=http://localhost:3000

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/pizzahub

# --- Better Auth ---
# Generate with: openssl rand -base64 32   (32+ characters, high entropy)
BETTER_AUTH_SECRET=
# Base URL of this server (no trailing slash)
BETTER_AUTH_URL=http://localhost:5000
# Base URL of the client app
APP_URL=http://localhost:3000

# --- Google OAuth (Google Cloud Console → OAuth 2.0 client) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- JWT (role based access on protected APIs) ---
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- Stripe (dashboard.stripe.com/apikeys — use TEST keys) ---
STRIPE_SECRET_KEY=
# Webhook signing secret: Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=
# Recurring price ID of the Premium plan
STRIPE_PRICE_ID=

# --- ImgBB (https://api.imgbb.com/) — menu item images ---
IMGBB_API_KEY=
