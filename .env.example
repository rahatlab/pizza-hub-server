PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB_NAME=pizzahub

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-this
BETTER_AUTH_SECRET=your-better-auth-secret-change-this
BETTER_AUTH_URL=http://localhost:5000

# Google OAuth (optional in dev)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ImgBB (image upload proxy)
IMGBB_API_KEY=your-imgbb-api-key

# Stripe (vendor premium subscription only)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PRICE_ID=price_your_stripe_price_id
STRIPE_PUBLISH_KEY=pk_test_your_stripe_publish_key

# Admin seeding
ADMIN_EMAIL=admin@pizzahub.com
